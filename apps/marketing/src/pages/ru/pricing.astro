---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import PricingGrid from "../../components/PricingGrid.astro";
import PricingQuotaMatrix from "../../components/PricingQuotaMatrix.astro";
import PricingComparisonTable from "../../components/PricingComparisonTable.astro";
import PricingFaq from "../../components/PricingFaq.astro";
import { getPricingContent } from "../../config/pricing";

const content = getPricingContent("ru");
---

<MarketingLayout canonicalPath="/ru/pricing" locale="ru" title="Тарифы" description="Тарифы VATranscribe для media download и transcription workflows.">
  <section class="section">
    <div class="container">
      <span class="eyebrow">{content.eyebrow}</span>
      <h1 class="h1">{content.title}</h1>
      <p class="lead">{content.lead}</p>

      <div class="card" style="margin-top: 28px;">
        <strong>Backend-aligned pricing</strong>
        <p class="muted" style="margin-bottom: 0;">{content.sourceNote}</p>
      </div>

      <h2 class="h2" style="margin-top: 52px;">{content.cardsTitle}</h2>
      <PricingGrid locale="ru" />
    </div>
  </section>

  <PricingQuotaMatrix locale="ru" />
  <PricingComparisonTable locale="ru" />
  <PricingFaq locale="ru" />

  <section class="section">
    <div class="container">
      <div class="card card-strong text-center">
        <span class="eyebrow">Следующий шаг</span>
        <h2 class="h2">{content.finalTitle}</h2>
        <p class="lead">{content.finalLead}</p>
        <div class="button-row" style="justify-content: center;">
          <a class="button button-primary" href="http://localhost:5175/auth/register?plan=pro">{content.finalPrimary}</a>
          <a class="button button-secondary" href="http://localhost:5175/app/billing?plan=pro">{content.finalSecondary}</a>
        </div>
      </div>
    </div>
  </section>
</MarketingLayout>