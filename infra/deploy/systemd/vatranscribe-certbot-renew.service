[Unit]
Description=VATranscribe certbot renewal
Wants=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/vatranscribe
Environment=PROJECT_ROOT=/srv/vatranscribe
Environment=RUNTIME_ENV_FILE=/opt/vatranscribe/secrets/.env.runtime
ExecStart=/srv/vatranscribe/infra/deploy/certbot-renew.sh
