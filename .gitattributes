# VATranscribeWeb repository line-ending policy.
# Keep shell/config files LF-safe for Linux deployment and CI.

* text=auto

# Shell / Unix executable scripts
*.sh text eol=lf
*.bash text eol=lf

# Python
*.py text eol=lf

# Frontend source
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.astro text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf

# Config / infra
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.conf text eol=lf
*.template text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf
.env.example text eol=lf
.env.production.example text eol=lf

# Docs
*.md text eol=lf
*.txt text eol=lf

# Windows scripts
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
*.zip binary
*.7z binary
*.rar binary
*.tar binary
*.gz binary
*.mp3 binary
*.mp4 binary
*.wav binary
*.webm binary
*.mkv binary
