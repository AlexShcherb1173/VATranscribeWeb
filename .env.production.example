# VATranscribeWeb production environment example.
# This file is a template only. Do not store real production secrets in Git.
# Runtime secrets must live in /opt/vatranscribe/secrets/.env.runtime or a supported vault source.

APP_NAME=VATranscribe API
APP_ENV=production
DEBUG=false
EXPOSE_API_DOCS=false
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# Public origins / domains. HTTPS only, no localhost, no wildcards.
PUBLIC_MARKETING_ORIGIN=https://vatranscribe.ru
PUBLIC_APP_ORIGIN=https://app.vatranscribe.ru
PUBLIC_API_ORIGIN=https://api.vatranscribe.ru
PUBLIC_ADMIN_ORIGIN=https://admin.vatranscribe.ru

# Domain / CDN / Certbot activation. Replace CHANGE_ME values before public production.
ROOT_DOMAIN=vatranscribe.ru
MARKETING_DOMAIN=vatranscribe.ru
APP_DOMAIN=app.vatranscribe.ru
API_DOMAIN=api.vatranscribe.ru
ADMIN_DOMAIN=admin.vatranscribe.ru
PRODUCTION_HOST_PUBLIC_IP=CHANGE_ME_PUBLIC_IPV4_OR_IPV6
DNS_PROVIDER=manual
CDN_PROVIDER=provider-neutral
CDN_API_ENABLED=false
CDN_MARKETING_STATIC_ENABLED=true
CDN_APP_STATIC_ENABLED=true
CDN_HTML_CACHE_POLICY=no-cache
CDN_ASSET_CACHE_SECONDS=31536000
CERTBOT_EMAIL=CHANGE_ME_CERTBOT_EMAIL
CERTBOT_DOMAINS=vatranscribe.ru,app.vatranscribe.ru,api.vatranscribe.ru,admin.vatranscribe.ru
CERTBOT_PRIMARY_DOMAIN=vatranscribe.ru
CERTBOT_WEBROOT=/var/www/certbot
CERTBOT_STAGING=false
CERTBOT_RSA_KEY_SIZE=4096
CERTBOT_RENEW_DEPLOY_HOOK_RELOAD=true
HSTS_PRELOAD_ENABLED=false
CHECK_DOMAIN_READINESS=false


# CORS must include only browser-facing HTTPS origins.
CORS_ORIGINS=https://vatranscribe.ru,https://app.vatranscribe.ru,https://admin.vatranscribe.ru

PYTHONPATH=.
DATABASE_URL=postgresql+psycopg://CHANGE_ME:CHANGE_ME@db:5432/vatranscribe
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
REDIS_URL=redis://redis:6379/0

# Generate a high-entropy value. Minimum length: 32 characters.
SECRET_KEY=CHANGE_ME_GENERATE_64_PLUS_RANDOM_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

COOKIE_SECURE=true
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=.vatranscribe.ru

STORAGE_ROOT=./storage
UPLOADS_DIR=./storage/uploads
DOWNLOADS_DIR=./storage/downloads
DOWNLOADS_AUDIO_DIR=./storage/downloads/audio
DOWNLOADS_VIDEO_DIR=./storage/downloads/video
TRANSCRIPTS_TXT_DIR=./storage/transcripts/txt
TRANSCRIPTS_SRT_DIR=./storage/transcripts/srt
TRANSCRIPTS_VTT_DIR=./storage/transcripts/vtt
TRANSCRIPTS_JSON_DIR=./storage/transcripts/json
TEMP_DIR=./storage/temp
LOGS_DIR=./storage/logs
COOKIES_DIR=./storage/cookies
YT_DLP_COOKIES_FILE=

FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
YT_DLP_PATH=yt-dlp

DEFAULT_LANGUAGE=ru
DEFAULT_TRANSCRIPTION_MODEL=medium


# YouTube cookies are stored per-user encrypted in DB.
# Generate a Fernet key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
YOUTUBE_COOKIES_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_FERNET
YOUTUBE_COOKIES_MAX_BYTES=1048576
YOUTUBE_COOKIES_TEMP_DIR=./storage/tmp/ytdlp-cookies

# yt-dlp / YouTube optional settings.
YT_DLP_PROXY_URL=
YT_DLP_YOUTUBE_PLAYER_CLIENT=
YT_DLP_YOUTUBE_PO_TOKEN=

# Frontend build/runtime values.
VITE_API_BASE_URL=https://api.vatranscribe.ru/api/v1
PUBLIC_VATRANSCRIBE_APP_URL=https://app.vatranscribe.ru
PUBLIC_VATRANSCRIBE_MARKETING_URL=https://vatranscribe.ru
WEB_HTTP_PORT=8080
VITE_BASE_PATH=/app/
REFRESH_COOKIE_NAME=vatranscribe_refresh_token
CSRF_COOKIE_NAME=vatranscribe_csrf_token
CSRF_HEADER_NAME=X-CSRF-Token

# Nginx / TLS / security headers.
# Replace domains/cert paths after final DNS and Let's Encrypt setup.
NGINX_SERVER_NAME=vatranscribe.ru app.vatranscribe.ru api.vatranscribe.ru admin.vatranscribe.ru
NGINX_SSL_CERTIFICATE=/etc/letsencrypt/live/vatranscribe.ru/fullchain.pem
NGINX_SSL_CERTIFICATE_KEY=/etc/letsencrypt/live/vatranscribe.ru/privkey.pem
NGINX_HSTS_MAX_AGE=31536000
NGINX_GENERAL_API_RATE=120r/m
NGINX_AUTH_RATE=10r/m
NGINX_AUTH_STRICT_RATE=5r/m
NGINX_UPLOAD_RATE=10r/m
NGINX_DOWNLOAD_RATE=30r/m
NGINX_GLOBAL_BODY_LIMIT=20m
NGINX_AUTH_BODY_LIMIT=1m
NGINX_ANALYZE_BODY_LIMIT=2m
NGINX_UPLOAD_BODY_LIMIT=1024m
WEB_HTTPS_PORT=443

# API rate limiting / trusted proxy.
# Nginx limit_req is the outer layer; Redis-backed API limiter is the inner distributed layer.
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_REDIS_URL=redis://redis:6379/2
RATE_LIMIT_FAIL_OPEN=false
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128 # CHANGE_ME_ADD_REAL_REVERSE_PROXY_CIDRS

# Admin security / two-factor authentication.
ADMIN_2FA_REQUIRED=true
ADMIN_2FA_ISSUER=VATranscribe
ADMIN_2FA_RECOVERY_CODE_COUNT=10
ADMIN_2FA_RECOVERY_CODE_BYTES=10
ADMIN_2FA_TOTP_WINDOW=1

RATE_LIMIT_GENERAL_API_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AUTH_STRICT_PER_MINUTE=5
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_DOWNLOAD_PER_MINUTE=30
RATE_LIMIT_ANALYZE_PER_MINUTE=10

# Upload/download/quota/retention limits
MAX_UPLOAD_BYTES=1073741824
UPLOAD_STREAM_CHUNK_BYTES=1048576
MAX_EXTERNAL_DOWNLOAD_BYTES=2147483648
MAX_EXPORT_ARTIFACT_BYTES=524288000
MAX_MEDIA_DOWNLOAD_BYTES=2147483648
TEMP_FILE_RETENTION_HOURS=24
FAILED_JOB_FILE_RETENTION_DAYS=7
EXPORT_ARTIFACT_RETENTION_DAYS=14
MEDIA_ASSET_RETENTION_DAYS=30
TRANSCRIPT_RETENTION_DAYS=90
CLEANUP_BATCH_SIZE=500

# Observability / monitoring / logs
MONITORING_REQUIRED=true
MONITORING_RELEASE_CHECKLIST_ACK=false
UPTIME_PROVIDER=uptime-kuma
UPTIME_ALERT_CHANNELS=telegram,email
UPTIME_CHECKS_BASE_URL=https://vatranscribe.ru
APM_PROVIDER=sentry
SENTRY_REQUIRED=true
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_WORKER_ENABLED=true
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=local-dev
VITE_SENTRY_TRACES_SAMPLE_RATE=0.0
CENTRAL_LOGGING_REQUIRED=true
CENTRAL_LOGGING_PROVIDER=loki
LOG_LEVEL=INFO
LOG_JSON=true
RELEASE_VERSION=local-dev
DOCKER_LOG_MAX_SIZE=50m
DOCKER_LOG_MAX_FILE=5
LOG_RETENTION_DAYS=30
LOKI_RETENTION_DAYS=14
NGINX_ACCESS_LOG_RETENTION_DAYS=30
NGINX_ERROR_LOG_RETENTION_DAYS=30
REQUEST_ID_HEADER=X-Request-ID

# Backup / restore / deploy operations
BACKUP_DIR=/backups/vatranscribe
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6
AGE_RECIPIENT=
BACKUP_ENCRYPTION_RECIPIENT=
AGE_IDENTITY_FILE=
BACKUP_REMOTE=
BACKUP_REMOTE_PATH=vatranscribe/postgres
S3_REMOTE=
S3_BACKUP_PATH=vatranscribe/postgres
SMOKE_BASE_URL=http://127.0.0.1
SMOKE_TIMEOUT_SECONDS=10

# Production secrets / vault policy.
# dev/local can use local .env. Production must use runtime-env-file or a vault adapter.
SECRET_MANAGER_STRATEGY=runtime-env-file
RUNTIME_ENV_FILE=/opt/vatranscribe/secrets/.env.runtime
PRODUCTION_SECRETS_VALIDATION_REQUIRED=true
SECRET_ROTATION_POLICY_VERSION=2026-06

# Legal / compliance. Replace all CHANGE_ME values before public production launch.
LEGAL_DOCUMENT_VERSION=2.0
LEGAL_OPERATOR_TYPE=CHANGE_ME_INDIVIDUAL_OR_SELF_EMPLOYED
LEGAL_OPERATOR_NAME=CHANGE_ME_REAL_OPERATOR_NAME
LEGAL_OPERATOR_INN=CHANGE_ME_IF_APPLICABLE
LEGAL_OPERATOR_OGRN=CHANGE_ME_IF_APPLICABLE
LEGAL_OPERATOR_ADDRESS=CHANGE_ME_REAL_OPERATOR_ADDRESS
LEGAL_CONTACT_EMAIL=CHANGE_ME_LEGAL_EMAIL
PRIVACY_CONTACT_EMAIL=CHANGE_ME_PRIVACY_EMAIL
SUPPORT_EMAIL=CHANGE_ME_SUPPORT_EMAIL
LEGAL_PRODUCTION_DOMAINS=vatranscribe.ru,app.vatranscribe.ru,api.vatranscribe.ru
LEGAL_TARGET_USERS=CHANGE_ME_RUSSIA_OR_WORLDWIDE_OR_PRIVATE_BETA
LEGAL_MAIN_DB_COUNTRY=CHANGE_ME_COUNTRY
LEGAL_BACKUP_COUNTRY=CHANGE_ME_COUNTRY
LEGAL_HOSTING_PROVIDER=disabled
LEGAL_CDN_PROVIDER=disabled
LEGAL_ANALYTICS_PROVIDER=disabled
LEGAL_APM_PROVIDER=disabled
LEGAL_PAYMENT_PROVIDER=disabled
LEGAL_EMAIL_PROVIDER=disabled
LEGAL_YOUTUBE_COOKIES_UPLOAD_ENABLED=true
LEGAL_ANALYTICS_COOKIES_ENABLED=false
LEGAL_MARKETING_PIXELS_ENABLED=false
LEGAL_CRM_AD_PIXELS_ENABLED=false
LEGAL_AUDIT_LOGS_RETENTION_DAYS=180
LEGAL_ACCOUNT_DELETION_GRACE_DAYS=30
LEGAL_BACKUP_RETENTION_POLICY=7 daily / 4 weekly / 6 monthly
LEGAL_BILLING_RECORDS_RETENTION=not enabled
LEGAL_152FZ_RUSSIAN_PD=false
LEGAL_152FZ_RKN_NOTIFICATION_STATUS=not_decided
LEGAL_152FZ_PD_LOCALIZATION_STATUS=not_decided

# Optional sensitive integrations. Keep empty until provider is enabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
PAYMENT_PROVIDER=disabled
PAYMENT_WEBHOOK_SECRET=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SIGNATURE_HEADER=X-VATranscribe-Signature
BILLING_FAKE_UPGRADE_ENABLED=false
BILLING_PAID_PLANS_ENABLED=false
