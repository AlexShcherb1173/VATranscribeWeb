---
import { siteConfig } from "../config/site";
const year = new Date().getFullYear();
---

<footer style="border-top: 1px solid var(--border); padding: 42px 0; background: rgba(0, 0, 0, 0.18);">
  <div class="container grid" style="grid-template-columns: 1.4fr 1fr 1fr; gap: 28px;">
    <div>
      <strong>{siteConfig.productName}</strong>
      <p class="muted" style="max-width: 420px;">{siteConfig.description}</p>
      <p class="muted">© {year} {siteConfig.productName}. All rights reserved.</p>
    </div>

    <div>
      <strong>Product</strong>
      <ul class="list">
        {siteConfig.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>

    <div>
      <strong>Legal</strong>
      <p class="muted" style="margin: 10px 0 0;"><a href="/legal">Legal center</a></p>
      <ul class="list">
        {siteConfig.legal.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>
  </div>
</footer>
