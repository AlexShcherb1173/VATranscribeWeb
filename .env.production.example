# VATranscribeWeb production environment example.
# Copy to .env on the production host and replace every placeholder before deploy.

APP_NAME=VATranscribe API
APP_ENV=production
DEBUG=false
EXPOSE_API_DOCS=false
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# Public origins / domains. HTTPS only, no localhost, no wildcards.
PUBLIC_MARKETING_ORIGIN=https://vatranscribe.ru
PUBLIC_APP_ORIGIN=https://app.vatranscribe.ru
PUBLIC_API_ORIGIN=https://api.vatranscribe.ru
PUBLIC_ADMIN_ORIGIN=https://admin.vatranscribe.ru

# CORS must include only browser-facing HTTPS origins.
CORS_ORIGINS=https://vatranscribe.ru,https://app.vatranscribe.ru,https://admin.vatranscribe.ru

PYTHONPATH=.
DATABASE_URL=postgresql+psycopg://CHANGE_ME:CHANGE_ME@db:5432/vatranscribe
REDIS_URL=redis://redis:6379/0

# Generate a high-entropy value. Minimum length: 32 characters.
SECRET_KEY=CHANGE_ME_GENERATE_64_PLUS_RANDOM_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

COOKIE_SECURE=true
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=.vatranscribe.ru

STORAGE_ROOT=./storage
UPLOADS_DIR=./storage/uploads
DOWNLOADS_DIR=./storage/downloads
DOWNLOADS_AUDIO_DIR=./storage/downloads/audio
DOWNLOADS_VIDEO_DIR=./storage/downloads/video
TRANSCRIPTS_TXT_DIR=./storage/transcripts/txt
TRANSCRIPTS_SRT_DIR=./storage/transcripts/srt
TRANSCRIPTS_VTT_DIR=./storage/transcripts/vtt
TRANSCRIPTS_JSON_DIR=./storage/transcripts/json
TEMP_DIR=./storage/temp
LOGS_DIR=./storage/logs
COOKIES_DIR=./storage/cookies
YT_DLP_COOKIES_FILE=

FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
YT_DLP_PATH=yt-dlp

DEFAULT_LANGUAGE=ru
DEFAULT_TRANSCRIPTION_MODEL=medium


# YouTube cookies are stored per-user encrypted in DB.
# Generate a Fernet key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
YOUTUBE_COOKIES_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_FERNET
YOUTUBE_COOKIES_MAX_BYTES=1048576
YOUTUBE_COOKIES_TEMP_DIR=./storage/tmp/ytdlp-cookies

# yt-dlp / YouTube optional settings.
YT_DLP_PROXY_URL=
YT_DLP_YOUTUBE_PLAYER_CLIENT=
YT_DLP_YOUTUBE_PO_TOKEN=

# Frontend build/runtime values.
VITE_API_BASE_URL=https://api.vatranscribe.ru/api/v1
PUBLIC_VATRANSCRIBE_APP_URL=https://app.vatranscribe.ru
PUBLIC_VATRANSCRIBE_MARKETING_URL=https://vatranscribe.ru
WEB_HTTP_PORT=8080
VITE_BASE_PATH=/app/
REFRESH_COOKIE_NAME=vatranscribe_refresh_token
CSRF_COOKIE_NAME=vatranscribe_csrf_token
CSRF_HEADER_NAME=X-CSRF-Token

# Nginx / TLS / security headers.
# Replace domains/cert paths after final DNS and Let's Encrypt setup.
NGINX_SERVER_NAME=vatranscribe.ru app.vatranscribe.ru api.vatranscribe.ru admin.vatranscribe.ru
NGINX_SSL_CERTIFICATE=/etc/letsencrypt/live/vatranscribe.ru/fullchain.pem
NGINX_SSL_CERTIFICATE_KEY=/etc/letsencrypt/live/vatranscribe.ru/privkey.pem
NGINX_HSTS_MAX_AGE=31536000
NGINX_GENERAL_API_RATE=120r/m
NGINX_AUTH_RATE=10r/m
NGINX_AUTH_STRICT_RATE=5r/m
NGINX_UPLOAD_RATE=10r/m
NGINX_DOWNLOAD_RATE=30r/m
NGINX_GLOBAL_BODY_LIMIT=20m
NGINX_AUTH_BODY_LIMIT=1m
NGINX_ANALYZE_BODY_LIMIT=2m
NGINX_UPLOAD_BODY_LIMIT=1024m
WEB_HTTPS_PORT=443

