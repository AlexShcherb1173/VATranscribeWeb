---
import { getDownloadContent } from "../config/download";
import type { Locale } from "../i18n/locales";

type Props = {
  locale?: Locale;
};

const { locale = "en" } = Astro.props;
const content = getDownloadContent(locale);
---

<section class="section">
  <div class="container">
    {locale !== "ru" && <span class="eyebrow">{content.requirementsTitle}</span>}
    <h2 class="h2">{content.requirementsTitle}</h2>
    <p class="lead">{content.requirementsLead}</p>

    <div class="table-card">
      <table class="pricing-table">
        <tbody>
          {content.requirements.map((item) => (
            <tr>
              <td><strong>{item.label}</strong></td>
              <td>{item.value}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
