---
import { pricingPlans } from "../config/pricing";
---

<div class="grid grid-3" style="margin-top: 30px;">
  {pricingPlans.map((plan) => (
    <article class={`card ${plan.highlighted ? "card-strong" : ""}`}>
      <span class={`badge ${plan.highlighted ? "badge-accent" : ""}`}>
        {plan.highlighted ? "Recommended" : plan.code}
      </span>
      <h3 style="font-size: 1.7rem; margin: 18px 0 0;">{plan.name}</h3>
      <p class="muted">{plan.description}</p>
      <div style="font-size: 2.4rem; font-weight: 900; letter-spacing: -0.06em;">
        {plan.price}
        <span class="muted" style="font-size: 0.95rem; font-weight: 500;"> / {plan.period}</span>
      </div>
      <p class="muted-strong" style="margin: 10px 0 0;">{plan.quota}</p>
      <ul class="list">
        {plan.features.map((feature) => <li>✓ {feature}</li>)}
      </ul>
      <a class="button button-primary button-block" href={plan.href} style="margin-top: 24px;">{plan.cta}</a>
    </article>
  ))}
</div>