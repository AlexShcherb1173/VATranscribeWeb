---
import { getPricingContent } from "../config/pricing";
import type { Locale } from "../i18n/locales";

type Props = {
  locale?: Locale;
};

const { locale = "en" } = Astro.props;
const content = getPricingContent(locale);
---

<section class="section">
  <div class="container">
    {locale !== "ru" && <span class="eyebrow">{content.faqTitle}</span>}
    <h2 class="h2">{content.faqTitle}</h2>
    <p class="lead">{content.faqLead}</p>

    <div style="margin-top: 24px;">
      {content.faq.map((faq) => (
        <details class="faq-item">
          <summary>{faq.question}</summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>