# App
APP_ENV=local
APP_NAME=VATranscribeWeb
APP_BASE_URL=http://localhost:5173
ADMIN_BASE_URL=http://localhost:5174
MARKETING_BASE_URL=http://localhost:4321
API_BASE_URL=http://localhost:8000

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/vatranscribe_web

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Auth
JWT_SECRET_KEY=change-me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Security
CORS_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:5173,http://localhost:5174
RATE_LIMIT_ENABLED=true

# Billing
BILLING_PROVIDER=mock
DEFAULT_FREE_PLAN_CODE=free
TRIAL_ENABLED=true
TRIAL_DAYS=7

# YooKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=
YOOKASSA_WEBHOOK_SECRET=

# CloudPayments
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=

# T-Bank
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_WEBHOOK_SECRET=

# Fiscalization
FISCALIZATION_PROVIDER=mock
FISCAL_RECEIPTS_ENABLED=false

# Ads / Affiliate
ADS_ENABLED=false
YANDEX_RSY_PARTNER_ID=
YANDEX_RSY_SITE_ID=
AFFILIATE_ENABLED=true

# Email
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com

# Storage
STORAGE_DRIVER=local
STORAGE_ROOT=storage
PUBLIC_STORAGE_BASE_URL=http://localhost:8000/storage
