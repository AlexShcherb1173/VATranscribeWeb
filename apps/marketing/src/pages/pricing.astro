---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import PricingGrid from "../components/PricingGrid.astro";
---

<MarketingLayout title="Pricing" description="VATranscribe pricing plans for media download and transcription workflows.">
  <section class="section">
    <div class="container">
      <span class="eyebrow">Pricing</span>
      <h1 class="h1">Plans for creators, developers and teams.</h1>
