---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
---

<MarketingLayout
  canonicalPath="/ru/500"
  title="Сервис временно недоступен"
  description="VATranscribe не смог выполнить запрос."
  noindex={true}
  locale="ru"
>
  <section class="section error-page-shell" aria-labelledby="page-title">
    <div class="container error-page-card">
      <span class="eyebrow">500</span>
      <h1 id="page-title" class="h1">Сервис временно недоступен</h1>
      <p class="lead">
        Запрос не удалось выполнить. Обновите страницу или перейдите в документацию, пока сервис восстанавливается.
      </p>
      <div class="error-page-actions">
        <a class="button button-primary" href="/ru/">На главную</a>
        <a class="button button-secondary" href="/ru/docs">В документацию</a>
      </div>
    </div>
  </section>
</MarketingLayout>
