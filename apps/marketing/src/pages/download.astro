---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import DownloadHero from "../components/DownloadHero.astro";
import DownloadPlatformCards from "../components/DownloadPlatformCards.astro";
import SystemRequirements from "../components/SystemRequirements.astro";
import ReleaseNotesPreview from "../components/ReleaseNotesPreview.astro";
import DownloadFaq from "../components/DownloadFaq.astro";
import { getDownloadContent } from "../config/download";

const content = getDownloadContent("en");
---

<MarketingLayout canonicalPath="/download" title="Download" description="VATranscribe download page for web app access, future desktop installers, release notes and checksum verification.">
  <DownloadHero locale="en" />
  <DownloadPlatformCards locale="en" />
  <SystemRequirements locale="en" />
  <ReleaseNotesPreview locale="en" />
  <DownloadFaq locale="en" />

  <section class="section">
    <div class="container">
      <div class="card card-strong text-center">
        <span class="eyebrow">Distribution path</span>
        <h2 class="h2">{content.finalTitle}</h2>
        <p class="lead">{content.finalLead}</p>
        <div class="button-row" style="justify-content: center;">
          <a class="button button-primary" href={content.primaryHref}>{content.finalPrimary}</a>
          <a class="button button-secondary" href="/pricing">{content.finalSecondary}</a>
        </div>
      </div>
    </div>
  </section>
</MarketingLayout>
