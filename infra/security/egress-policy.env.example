# VATranscribe production egress policy template.
# Copy to infra/security/egress-policy.env and adjust for production host/container names.

VATRANSCRIBE_API_CONTAINER=vatranscribe-api
VATRANSCRIBE_WORKER_CONTAINER=vatranscribe-worker
VATRANSCRIBE_DB_CONTAINER=vatranscribe-db
VATRANSCRIBE_REDIS_CONTAINER=vatranscribe-redis
VATRANSCRIBE_EGRESS_CHAIN=VATRANSCRIBE-EGRESS

# Strict mode allows only DB/Redis and public TCP 80/443 after private/metadata blocks.
VATRANSCRIBE_EGRESS_STRICT=true

# Logging can be noisy. Enable only during validation or incident response.
VATRANSCRIBE_EGRESS_LOG_DENIES=false
