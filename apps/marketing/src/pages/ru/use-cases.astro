---
import MarketingLayout from "../../layouts/MarketingLayout.astro";

const detailedCases = [
  {
    id: "creators",
    label: "Авторы",
    title: "Авторы и редакторы",
    points: [
      "Собирать исходные видео и аудиофайлы.",
      "Готовить MP3/MP4-файлы для монтажа или повторного использования.",
      "Создавать транскрипты для субтитров, заметок и переиспользования контента."
    ]
  },
  {
    id: "developers",
    label: "Разработчики",
    title: "Разработчики и тестировщики",
    points: [
      "Проверять задачи скачивания и транскрибации по журналам выполнения.",
      "Тестировать лимиты, владение файлами и сценарии авторизации в сервисной архитектуре.",
      "Использовать проект как полноценную основу для портфолио."
    ]
  },
  {
    id: "teams",
    label: "Команды",
    title: "Команды и операторы",
    points: [
      "Выстраивать контролируемые процессы обработки медиафайлов.",
      "Отслеживать запросы по персональным данным и версии согласий.",
      "Развивать продукт в сторону тарифов, администрирования и совместной работы."
    ]
  }
];
---

<MarketingLayout canonicalPath="/ru/use-cases" locale="ru" title="Сценарии" description="Сценарии VATranscribe для авторов, разработчиков и команд.">
  <section class="section">
    <div class="container">
      <span class="eyebrow">Сценарии</span>
      <h1 class="h1">Платформа для работы с медиа под разные продуктовые сценарии.</h1>
      <p class="lead">
        VATranscribe можно использовать как инструмент для авторов, рабочий контур для разработчиков
        или основу командного веб-сервиса.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container grid">
      {detailedCases.map((item) => (
        <article class="card" id={item.id}>
          <span class="eyebrow">{item.label}</span>
          <h2 class="h2">{item.title}</h2>
          <ul class="list">
            {item.points.map((point) => <li>✓ {point}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>
</MarketingLayout>
