{
  "name": "vatranscribe-web",
  "private": true,
  "version": "0.1.0",
  "description": "Commercial SaaS/Web monorepo for VATranscribe.",
  "workspaces": [
    "apps/marketing",
    "apps/web",
    "apps/admin",
    "apps/desktop",
    "packages/shared-types",
    "packages/sdk"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev:marketing": "npm run dev --workspace apps/marketing",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:admin": "npm run dev --workspace apps/admin",
    "dev:desktop": "npm run dev --workspace apps/desktop"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
