---
import { siteConfig } from "../config/site";
---

<section class="section">
  <div class="container">
    <div class="card text-center">
      <span class="eyebrow">Next step</span>
      <h2 class="h2">Turn the foundation into a public product surface.</h2>
      <p class="lead">
        Use the marketing layer to validate positioning, explain workflows and move visitors into the SaaS dashboard.
      </p>
      <div class="button-row" style="justify-content: center;">
        <a class="button button-primary" href={`${siteConfig.appUrl}/auth/register`}>Open dashboard</a>
        <a class="button button-secondary" href="/pricing">Compare plans</a>
      </div>
    </div>
  </div>
</section>