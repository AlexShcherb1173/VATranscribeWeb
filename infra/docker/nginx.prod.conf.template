limit_req_zone $binary_remote_addr zone=general_api_limit:10m rate=${NGINX_GENERAL_API_RATE};
limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=${NGINX_AUTH_RATE};
limit_req_zone $binary_remote_addr zone=auth_strict_limit:10m rate=${NGINX_AUTH_STRICT_RATE};
limit_req_zone $binary_remote_addr zone=upload_limit:10m rate=${NGINX_UPLOAD_RATE};
limit_req_zone $binary_remote_addr zone=download_limit:10m rate=${NGINX_DOWNLOAD_RATE};

map $request_uri $vatranscribe_cache_control {
    default "no-cache, max-age=0, must-revalidate";
    ~^/healthz(?:\?|$) "no-store";
    ~^/api/ "no-store";
    ~^/app/assets/ "public, max-age=${CDN_ASSET_CACHE_SECONDS}, immutable";
    ~^/assets/ "public, max-age=${CDN_ASSET_CACHE_SECONDS}, immutable";
    ~^/_astro/ "public, max-age=${CDN_ASSET_CACHE_SECONDS}, immutable";
}

log_format vatranscribe_json escape=json '{'
    '"time":"$time_iso8601",'
    '"remote_addr":"$remote_addr",'
    '"request_id":"$request_id",'
    '"method":"$request_method",'
    '"uri":"$request_uri",'
    '"status":$status,'
    '"bytes_sent":$bytes_sent,'
    '"request_time":$request_time,'
    '"upstream_response_time":"$upstream_response_time",'
    '"http_referer":"$http_referer",'
    '"http_user_agent":"$http_user_agent"'
'}';

server {
    listen 80;
    server_name ${NGINX_SERVER_NAME};
    server_tokens off;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        add_header Cache-Control "no-store" always;
        return 200 "ok\n";
    }

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        try_files $uri =404;
        add_header Cache-Control "no-store" always;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name ${NGINX_SERVER_NAME};
    server_tokens off;
    absolute_redirect off;

    access_log /var/log/nginx/access.log vatranscribe_json;
    error_log /var/log/nginx/error.log warn;

    charset utf-8;
    client_max_body_size ${NGINX_GLOBAL_BODY_LIMIT};
    limit_req_status 429;

    ssl_certificate ${NGINX_SSL_CERTIFICATE};
    ssl_certificate_key ${NGINX_SSL_CERTIFICATE_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    gzip on;
    gzip_types
        text/plain
        text/css
        application/json
        application/javascript
        application/xml
        image/svg+xml;

    add_header Strict-Transport-Security "max-age=${NGINX_HSTS_MAX_AGE}; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), fullscreen=(self)" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ${PUBLIC_API_ORIGIN} https://sentry.io https://*.sentry.io; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header Cache-Control "$vatranscribe_cache_control" always;

    location = /healthz {
        access_log off;
        default_type "text/plain";
        return 200 "ok\n";
    }

    location ~ ^/api/v1/auth/(login|register)$ {
        client_max_body_size ${NGINX_AUTH_BODY_LIMIT};
        limit_req zone=auth_strict_limit burst=5 nodelay;
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location ~ ^/api/v1/auth/(refresh|logout|logout-all|me)$ {
        client_max_body_size ${NGINX_AUTH_BODY_LIMIT};
        limit_req zone=auth_limit burst=10 nodelay;
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location = /api/v1/downloads/analyze {
        client_max_body_size ${NGINX_ANALYZE_BODY_LIMIT};
        limit_req zone=general_api_limit burst=30 nodelay;
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location ^~ /api/v1/uploads {
        client_max_body_size ${NGINX_UPLOAD_BODY_LIMIT};
        limit_req zone=upload_limit burst=5 nodelay;
        proxy_request_buffering off;
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location ~ ^/api/v1/(media-assets|export-artifacts|transcripts)/.*download$ {
        limit_req zone=download_limit burst=30 nodelay;
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location /api/ {
        client_max_body_size ${NGINX_GLOBAL_BODY_LIMIT};
        limit_req zone=general_api_limit burst=60 nodelay;
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }


    location ^~ /app/assets/ {
        alias /usr/share/nginx/html/web/assets/;
        try_files $uri =404;
    }

    location ^~ /assets/ {
        root /usr/share/nginx/html/marketing;
        try_files $uri =404;
    }

    location ^~ /_astro/ {
        root /usr/share/nginx/html/marketing;
        try_files $uri =404;
    }

    location = /app {
        return 308 /app/;
    }

    location ^~ /app/ {
        alias /usr/share/nginx/html/web/;
        try_files $uri $uri/ /index.html;
    }

    location ~ ^/(auth|dashboard|billing)(/.*)?$ {
        root /usr/share/nginx/html/web;
        try_files /index.html =404;
    }

    location / {
        root /usr/share/nginx/html/marketing;
        index index.html;
        try_files $uri/index.html $uri $uri/ /index.html;
    }
}
