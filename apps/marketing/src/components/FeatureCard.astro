---
type Props = {
  title: string;
  description: string;
  href?: string;
};

const { title, description, href } = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag class="card" href={href}>
  <h3 style="margin: 0 0 10px; font-size: 1.25rem;">{title}</h3>
  <p class="muted" style="margin: 0; line-height: 1.65;">{description}</p>
</Tag>
