---
import { getPricingContent } from "../config/pricing";
import type { Locale } from "../i18n/locales";

type Props = {
  locale?: Locale;
};

const { locale = "en" } = Astro.props;
const content = getPricingContent(locale);
---

<div class="pricing-period" aria-label="Billing period selector foundation">
  <span class="pricing-period-option active">{content.periodToggle.monthly}</span>
  <span class="pricing-period-option">{content.periodToggle.yearly}</span>
  <span class="pricing-period-note">{content.periodToggle.yearlyNote}</span>
</div>

<div class="grid grid-3 pricing-grid">
  {content.plans.map((plan) => (
    <article class={`pricing-card card ${plan.highlighted ? "card-strong pricing-card-featured" : ""}`}>
      <div class="pricing-card-top">
        <span class={`badge ${plan.highlighted ? "badge-accent" : ""}`}>{plan.badge}</span>
        <span class="pricing-plan-code">{plan.code}</span>
      </div>

      <h3 class="pricing-plan-name">{plan.name}</h3>
      <p class="muted">{plan.description}</p>

      <div class="pricing-price">
        <span>{plan.price}</span>
        <small>/ {plan.period}</small>
      </div>

      <p class="muted-strong">{plan.quota}</p>
      <p class="pricing-best-for">{plan.bestFor}</p>

      <div class="pricing-mini-quota">
        <div><strong>{plan.storage}</strong><span>Storage</span></div>
        <div><strong>{plan.transcription}</strong><span>Transcription</span></div>
        <div><strong>{plan.jobs}</strong><span>Jobs</span></div>
      </div>

      <ul class="list">
        {plan.features.map((feature) => <li>✓ {feature}</li>)}
      </ul>

      <a class="button button-primary button-block" href={plan.href}>{plan.cta}</a>
      <p class="pricing-yearly-note">{plan.yearlyNote}</p>
    </article>
  ))}
</div>