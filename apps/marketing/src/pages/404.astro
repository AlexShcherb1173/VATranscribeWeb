---
import MarketingLayout from "../layouts/MarketingLayout.astro";
---

<MarketingLayout
  canonicalPath="/404"
  title="Page not found"
  description="The requested VATranscribe page could not be found."
  noindex={true}
>
  <section class="section error-page-shell" aria-labelledby="page-title">
    <div class="container error-page-card">
      <span class="eyebrow">404</span>
      <h1 id="page-title" class="h1">Page not found</h1>
      <p class="lead">
        The page was moved, renamed or no longer exists. Use the navigation below to return to a valid VATranscribe section.
      </p>
      <div class="error-page-actions">
        <a class="button button-primary" href="/">Open home page</a>
        <a class="button button-secondary" href="/docs">Open documentation</a>
      </div>
    </div>
  </section>
</MarketingLayout>
