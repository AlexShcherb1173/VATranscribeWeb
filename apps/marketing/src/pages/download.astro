---
import MarketingLayout from "../layouts/MarketingLayout.astro";
---

<MarketingLayout title="Download" description="Download VATranscribe desktop and trial tools.">
  <section class="section">
    <div class="container">
      <span class="eyebrow">Download</span>
      <h1 class="h1">Desktop download page foundation.</h1>
      <p class="lead">This page will host desktop installers, version notes and trial download tracking.</p>
      <div class="button-row">
        <a class="button button-primary" href="/docs">Read setup docs</a>
        <a class="button button-secondary" href="/pricing">Compare plans</a>
      </div>
    </div>
  </section>
</MarketingLayout>
